<Page x:Class="BikeShop.ProductsManagementMVVM"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BikeShop"
      xmlns:vm="clr-namespace:BikeShop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductsManagementMVVM"
      Background="{StaticResource background}"
      >
    <Page.DataContext>
        <vm:ProductsManagementMVVMViewModel/>
    </Page.DataContext>

    <Grid>
        <TextBlock TextWrapping="Wrap" Text="Search" Margin="10,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox x:Name="textBox" TextWrapping="Wrap" Height="26" VerticalAlignment="Top" Margin="58,10,10,0" 
                 Text="{Binding SearchInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <DataGrid x:Name="dataGrid" ItemsSource="{Binding FoundProducts}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" Margin="10,53,291,10"/>
        <Border 
            DataContext="{Binding SelectedProduct}"
            BorderBrush="Black" BorderThickness="1" Margin="527,53,10,10" Background="White">

            <StackPanel Margin="10">
                <TextBlock Text="Product details"
                           FontWeight="Bold"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="10"/>
                <TextBlock Text="Title"/>
                <TextBox Text="{Binding Title, Mode=TwoWay}"/>
                <TextBlock Text="Price"/>
                <TextBox Text="{Binding Price, Mode=TwoWay}"/>
                <TextBlock Text="Color"/>
                <TextBox Text="{Binding Color, Mode=TwoWay}"/>
                <Border Background="{Binding Color}" Height="10"/>
                <TextBlock Text="Reference"/>
                <TextBox Text="{Binding Reference, Mode=TwoWay}"/>
            </StackPanel>

        </Border>
    </Grid>
</Page>
